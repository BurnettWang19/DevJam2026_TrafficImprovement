APP_NAME="Road Intersection AI"
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
OVERPASS_URL="https://overpass-api.de/api/interpreter"
OVERPASS_FALLBACK_URL="https://overpass.private.coffee/api/interpreter"
OSM_TIMEOUT_SECONDS=25

# Copy this file to backend/.env and fill the values locally.
# Never commit real keys.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_REASONING_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT_SECONDS=90

GOOGLE_MAPS_API_KEY=
IMAGERY_WIDTH=640
IMAGERY_HEIGHT=640
IMAGERY_SCALE=2

EVALUATION_PROMPT_PATH=prompts/intersection_evaluation_system_prompt.md
CLASSIC_CASES_PATH=classic_cases/cases.json
MAX_CLASSIC_CASE_MATCHES=3
