# 複製這個檔案成 .env（放在專案根目錄），填入你的金鑰

# Google AI Studio 取得：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Cloud Console -> APIs & Services -> Credentials
# 必須啟用 "Maps Static API"
GOOGLE_MAPS_API_KEY=

# Firestore + Google Cloud Storage 歷史紀錄（使用 Application Default Credentials）
GCP_PROJECT_ID=
GCS_BUCKET=
HISTORY_COLLECTION=analysis_history
HISTORY_STORAGE_PREFIX=analyses
