# 複製這個檔案成 .env（放在專案根目錄），填入你的金鑰

# Google AI Studio 取得：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Cloud Console -> APIs & Services -> Credentials
# 必須啟用 "Maps Static API"
GOOGLE_MAPS_API_KEY=

# 分析歷史紀錄的 GCS bucket 名稱（選填，留空 = 停用歷史功能）
# 本機需先 gcloud auth application-default login；
# Cloud Run 用執行服務帳戶，需要 bucket 的 Storage Object Admin 權限
GCS_HISTORY_BUCKET=
